<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Automated tests of the headset's person detection (feature 8D) and server address entry (9D), outside Unity.
    The folder name ends with "~", so Unity does not import it.
    Run (from the repository root): dotnet run with the project quest3_client/Tests~/DetectionTests
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/ShiroMR/ShiroPersonDetection.cs" Link="ShiroPersonDetection.cs" />
    <Compile Include="../../Assets/Scripts/ShiroMR/ShiroPersonLinking.cs" Link="ShiroPersonLinking.cs" />
    <Compile Include="../../Assets/Scripts/ShiroMR/ShiroServerAddress.cs" Link="ShiroServerAddress.cs" />
  </ItemGroup>
</Project>
