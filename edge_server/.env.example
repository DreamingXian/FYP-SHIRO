# =============================================================================
# SHIRO Edge Server configuration
# Copy this file to .env and fill in the values. Never commit .env.
# =============================================================================

# Ports
HTTP_PORT=3000
MQTT_PORT=1883

# MySQL (XAMPP default is user root with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shiro_db

# InfluxDB v2. Leave INFLUX_TOKEN empty to disable time-series logging.
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=
INFLUX_ORG=shiro_org
INFLUX_BUCKET=shiro_telemetry
