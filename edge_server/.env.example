# =============================================================================
# SHIRO Edge Server configuration
# Copy this file to .env and fill in the values. Never commit .env.
# =============================================================================

# Ports
HTTP_PORT=3000
MQTT_PORT=1883

# MQTT login for the anchors (required: the server does not start without it).
# Put the same two values in firmware/shiro_anchor_node/secrets.h
# (SHIRO_MQTT_USER, SHIRO_MQTT_PASSWORD). Password: 16 to 128 printable
# characters, no spaces. All anchors share this login.
MQTT_ANCHOR_USER=shiro-anchor
MQTT_ANCHOR_PASSWORD=

# MySQL: a dedicated account with rights on shiro_db only (see
# SYSTEM_STARTUP_PROCEDURE.md, "Database account"). Not root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shiro_app
DB_PASSWORD=
DB_NAME=shiro_db

# InfluxDB v2. Leave INFLUX_TOKEN empty to disable time-series logging.
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=
INFLUX_ORG=shiro_org
INFLUX_BUCKET=shiro_telemetry

# Console log level: error, warn, info (default) or debug.
# debug adds the stack of every logged error.
LOG_LEVEL=info

# Live Lab test bench (simulated alarms, always marked as simulated in the audit log).
# Set to false outside testing and demonstrations.
ENABLE_SIMULATION=true
